#!/usr/bin/env python3

import socket
import time
from pathlib import Path

motd = "Canine Colonies (local)"

hostname = Path("/etc/hostname").read_text().strip()

(port, motd) = {
    "minecraft":    (25565, "Canine Colonies (Production; {ref})"),
    "mc-dev":       (25566, "Canine Colonies (Development; {ref})"),
    "mc-test":      (25567, "Canine Colonies (Testing; {ref})"),
}[hostname]

metadata = Path("/opt/minecraft/server/build-info.txt").read_text().strip().split("\n")
metadata = dict([line.split("=") for line in metadata])

motd = motd.format(ref=metadata['COMMIT'])
port = str(port)

sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)

print("Broadcasting Minecraft server to LAN")
print(f"MOTD: {motd}")

while True:
    sock.sendto(f"[MOTD]{motd}[/MOTD][AD]{port}[/AD]".encode('UTF-8'),
                ("255.255.255.255", 4445))
    time.sleep(1.5)
