#!/bin/bash

OUTPUT_FILE=/opt/minecraft/server/config/discord_chat_mod-common.toml
TEMPLATE_FILE=${OUTPUT_FILE}.template

TOKEN_FILE=/etc/advanced-colonies/discord-bot-token.txt
CHANNEL_FILE=/etc/advanced-colonies/discord-channel-id.txt
SERVER_NAME_FILE=/etc/advanced-colonies/discord-mc-server-name.txt

if [ ! -f "$TOKEN_FILE" ]; then
    echo "Token file does not exist: ${TOKEN_FILE}"
    exit
fi

if [ ! -f "$CHANNEL_FILE" ]; then
    echo "Channel file does not exist: ${CHANNEL_FILE}"
    exit
fi

if [ ! -f "$SERVER_NAME_FILE" ]; then
    echo "Server name file does not exist: ${SERVER_NAME_FILE}"
    exit
fi


BOT_TOKEN=$(cat $TOKEN_FILE)
CHANNEL_ID=$(cat $CHANNEL_FILE)
SERVER_NAME=$(cat $SERVER_NAME_FILE)

if [ -z "${BOT_TOKEN}" ]; then
    echo "Nothing in ${TOKEN_FILE}"
    exit
fi

if [ -z "${CHANNEL_ID}" ]; then
    echo "Nothing in ${CHANNEL_FILE}"
    exit
fi

if [ -z "${SERVER_NAME}" ]; then
    echo "Nothing in ${SERVER_NAME_FILE}"
    exit
fi

# If we get here, we can actually do something.
sed 's/\$\$DISCORD_BOT_TOKEN\$\$/'"${BOT_TOKEN}"'/; s/\$\$DEFAULT_CHANNEL_ID\$\$/'"${CHANNEL_ID}"'/; s/\$\$SERVER_NAME\$\$/'"${SERVER_NAME}"'/' "$TEMPLATE_FILE" > "$OUTPUT_FILE"
