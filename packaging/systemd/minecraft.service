[Unit]
Description=Minecraft Server
After=network.target

[Service]
User=minecraft
Group=minecraft

WorkingDirectory=/opt/minecraft/server

Restart=always
RestartSec=30

ExecStart=bash -c "[ -f /opt/minecraft/server/no-restart ] && echo 'Waiting for no-restart condition to end...' || exec /opt/minecraft/server/run.sh"

NoNewPrivileges=true

[Install]
WantedBy=default.target
