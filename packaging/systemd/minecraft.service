[Unit]
Description=Minecraft Server
After=network.target
ConditionPathExists=!/opt/minecraft/server/minecraft.disable
ConditionPathExists=!/tmp/minecraft.disable

[Service]
User=minecraft
Group=minecraft

WorkingDirectory=/opt/minecraft/server

Restart=always
RestartSec=30

ExecStartPre=/opt/bin/_ac-apply-discord-config-template

ExecStart=java @user_jvm_args.txt -Djava.rmi.server.hostname=%H @libraries/net/neoforged/neoforge/21.1.216/unix_args.txt
ExecStop=timeout 60 bash -c "kill -INT $MAINPID && tail --pid=$MAINPID -f /dev/null"

NoNewPrivileges=true

[Install]
WantedBy=default.target
