#!/bin/sh
# prerm script for advanced-colonies-server.
#
# See: dh_installdeb(1).

set -e

# Summary of how this script can be called:
#        * <prerm> 'remove'
#        * <old-prerm> 'upgrade' <new-version>
#        * <new-prerm> 'failed-upgrade' <old-version>
#        * <conflictor's-prerm> 'remove' 'in-favour' <package> <new-version>
#        * <deconfigured's-prerm> 'deconfigure' 'in-favour'
#          <package-being-installed> <version> 'removing'
#          <conflicting-package> <version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package.


case "$1" in
    remove|upgrade|deconfigure)
        systemctl disable minecraft
        systemctl disable sync-map.timer
        systemctl disable lan-broadcast.service
        systemctl disable lets-encrypt.timer

        AUTOMODPACK=/opt/minecraft/server/automodpack/.private
        # If the automodpack cert and/or key are symlinks, remove them.
        [ -s $AUTOMODPACK/cert.crt ] && rm $AUTOMODPACK/cert.crt
        [ -s $AUTOMODPACK/key.pem ] && rm $AUTOMODPACK/key.pem
    ;;

    failed-upgrade)
    ;;

    *)
        echo "prerm called with unknown argument '$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
