#!/bin/sh
# postinst script for advanced-colonies-server.
#
# See: dh_installdeb(1).

set -e

# Summary of how this script can be called:
#        * <postinst> 'configure' <most-recently-configured-version>
#        * <old-postinst> 'abort-upgrade' <new version>
#        * <conflictor's-postinst> 'abort-remove' 'in-favour' <package>
#          <new-version>
#        * <postinst> 'abort-remove'
#        * <deconfigured's-postinst> 'abort-deconfigure' 'in-favour'
#          <failed-install-package> <version> 'removing'
#          <conflicting-package> <version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package.


case "$1" in
    configure)
        chown -R minecraft:minecraft /opt/minecraft
        chmod -R 700 /opt/minecraft/.ssh
        chmod 600 /opt/minecraft/.ssh/*

        systemctl daemon-reload
        systemctl enable minecraft
        systemctl enable sync-map.timer
        systemctl enable lets-encrypt.timer
        systemctl enable ac-update-server.timer
        systemctl enable ac-restarter.timer

        # Start or restart the services.
        systemctl restart minecraft
        systemctl restart sync-map.timer
        systemctl restart lets-encrypt.timer
        systemctl restart ac-update-server.timer
        systemctl restart ac-restarter.timer

        rm -f /opt/minecraft/server/minecraft.needs-update
        rm -f /opt/minecraft/server/minecraft.disable
        rm -f /tmp/minecraft.needs-restart
        rm -f /tmp/minecraft.needs-update
        rm -f /tmp/minecraft.disable
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
